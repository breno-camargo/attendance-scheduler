# Variáveis de Ambiente — CompaSSS Scheduler
# Copie este arquivo para .env e preencha com seus dados reais

# ── Banco de Dados (Supabase PostgreSQL) ─────────────────────────────────────
# Usar a URL com pooler (Transaction mode) para queries da aplicação
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL direta (sem pooler) — usada pelo Prisma para rodar migrations
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# URL base da aplicação (dev: http://localhost:3000 | prod: https://seu-dominio)
NEXTAUTH_URL="http://localhost:3000"

# Secret pra assinar JWT de sessão — gerar com `openssl rand -base64 32`
NEXTAUTH_SECRET=

# ── Email (domínio mostrado em templates e reset de senha) ───────────────────
EMAIL_DOMAIN="compasss.com.br"
NEXT_PUBLIC_EMAIL_DOMAIN="compasss.com.br"

# ── SMTP (envio de email de reset de senha) ──────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=
SMTP_PASS=
# Opcional — remetente. Se vazio, usa SMTP_USER
SMTP_FROM=

# ── Upstash Redis (opcional — sem ele usa rate limiting in-memory) ───────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
