# Variáveis de Ambiente — CompaSSS Scheduler
# Copie este arquivo para .env e preencha com seus dados reais

# ── Banco de Dados (Supabase PostgreSQL) ─────────────────────────────────────
# Usar a URL com pooler (Transaction mode) para queries da aplicação
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL direta (sem pooler) — usada pelo Prisma para rodar migrations
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_DOMAIN="compasss.com.br"
NEXT_PUBLIC_EMAIL_DOMAIN="compasss.com.br"

# Upstash Redis (opcional - sem ele usa rate limiting in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
